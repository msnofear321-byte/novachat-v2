rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Simple auth/participant-enforced rules for NovaChat

    // Users: readable by authenticated users; writable only by the user themself
    //
    // Presence hardening: `online` must be a boolean, and `lastSeen` /
    // `lastActive` must be server timestamps (they must equal the request's
    // server time). A client cannot forge fake "online" or fake "last seen".
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.online is bool || !('online' in request.resource.data))
        && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time)
        && (!('lastActive' in request.resource.data) || request.resource.data.lastActive == request.time);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Conversations: only participants can read; creators must include themselves
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2;

      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Messages stored at: /messages/{conversationId}/messages/{messageId}
    match /messages/{conversationId}/messages/{messageId} {
      // reads only for conversation participants
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

      // create: senderId must match authenticated user and conversation must include sender
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.conversationId == conversationId
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        && request.resource.data.createdAt is number;

      // update: the sender may edit/delete/star their own messages; any
      // conversation participant may update read/delivered receipts, reactions,
      // starring/pinning and "delete for me" (deletedBy). This matches the
      // client (see src/services/firestore.ts), so receipt writes no longer
      // fail with permission-denied during a chat.
      allow update: if request.auth != null
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        && (resource.data.senderId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'read', 'delivered', 'starred', 'pinned', 'deletedBy', 'reactions'
            ]));

      // delete only by the original sender
      allow delete: if request.auth != null
        && resource.data.senderId == request.auth.uid
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Typing status per-user
    match /typing/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Stories (status updates)
    //
    // Reads follow the story's privacy field so 'nobody'/'selected' statuses
    // cannot be pulled through the SDK. 'contacts' privacy would require the
    // owner's contacts doc (a get() that breaks collection queries), and no
    // contacts feature ships yet, so those reads are effectively owner-only —
    // matching what the client computes today.
    match /stories/{storyId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || !('privacy' in resource.data)
        || resource.data.privacy == 'everyone'
        || (resource.data.privacy == 'selected'
            && resource.data.allowedUsers is list
            && request.auth.uid in resource.data.allowedUsers)
      );
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // The owner may edit or delete freely; any authenticated user may mark a
      // story seen or like/unlike it (seenBy/likes only), which the viewer UI
      // depends on.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy', 'likes'])
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Calls (meta). Access is based on the caller/receiver ids written by the
    // client (see src/services/calls.ts). Reads are granted for collection
    // queries filtered by `receiverId`/`callerId` (incoming-call listener,
    // cleanup, in-call checks) as well as direct doc reads.
    match /calls/{callId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerId
        && request.resource.data.receiverId is string
        && request.resource.data.receiverId != request.resource.data.callerId;
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      // allow basic access for subcollections (ICE candidates) to the call's
      // caller and receiver
      match /{subcol=**} {
        allow read, write: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerId
              || request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.receiverId);
      }
    }

    // Blocked users (per-user)
    match /blocked/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Call history (written by either party; queried by callerId/receiverId)
    match /callHistory/{docId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
      allow create: if request.auth != null
        && (request.auth.uid == request.resource.data.callerId
            || request.auth.uid == request.resource.data.receiverId);
      allow update, delete: if request.auth != null
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
    }

    // Reports
    match /reports/{docId} {
      allow create: if request.auth != null && request.resource.data.reporterId == request.auth.uid;
      allow read: if request.auth != null;
      allow delete: if false;
    }

    // Groups and group messages (basic checks)
    match /groups/{groupId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.resource.data.members is list && request.auth.uid in request.resource.data.members;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.admins;
    }

    match /groupMessages/{groupId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      allow create: if request.auth != null
        && request.resource.data.senderId == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }

    // Live locations
    match /liveLocations/{conversationId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      allow create, update, delete: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Music status
    match /musicStatus/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Music notes (feed of per-user music notes)
    match /musicNotes/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Secret chats
    match /secretChats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.resource.data.participants is list && request.auth.uid in request.resource.data.participants;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Secret chat messages (per-user encrypted inbox)
    match /secretChats/{userId}/messages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Secret chat locks
    match /secretChatLocks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Notes
    match /notes/{userId}/items/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Personal Documents (private, owner-only)
    //
    // Metadata for a user's private documents lives at
    // documents/{userId}/files/{docId}. Only the owner may read, create,
    // update or delete. File bytes are stored in Firebase Storage under
    // documents/{userId}/... (see storage.rules) and are never exposed as
    // public URLs — the owner always owns the storage path via ownerId.
    match /documents/{userId}/files/{docId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == userId
        && request.resource.data.category is string
        && request.resource.data.name is string
        && request.resource.data.fileType is string
        && request.resource.data.storagePath is string
        && request.resource.data.createdAt is number;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Temporary 24h notes (one per user at notes/{userId}). Readable by any
    // authenticated user so the recipient can see the note above the chat
    // header; writable only by the owner. Only the owner may forge/edit/delete.
    match /notes/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
