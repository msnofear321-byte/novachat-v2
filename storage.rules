rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Personal Documents: file bytes are private to their owner. Paths are
    // always documents/{uid}/<docId>, so the owner UID is enforced by the
    // path segment AND the authenticated user id must match.
    match /documents/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
